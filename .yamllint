extends: default
rules:
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1 # permite `{ chave: valor }`
  line-length:
    max: 120
  document-start: disable
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false # `on:` dos workflows do GitHub
  comments:
    min-spaces-from-content: 1

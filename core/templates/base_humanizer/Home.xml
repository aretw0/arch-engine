<?xml version="1.0" encoding="UTF-8"?>
<!--
  base_humanizer/Home.xml — template SH3D agnóstico (Sweet Home 3D ≥ 5.3).

  Um .sh3d é um zip; esta é a entrada `Home.xml` (DTD: https://www.sweethome3d.com/SweetHome3D.dtd).
  Os placeholders (sintaxe do string.Template do Python) vêm de `arch_engine.sh3d.parametros_sh3d` (centímetros; ângulos em radianos
  onde o SH3D exige). Copie para `<instancia>/cad/sh3d/Home.xml` e adapte.

  Ordem dos elementos segue o DTD: environment, compass, câmeras, peças/luzes, paredes, cômodos.
  Câmeras e luzes são pontos de partida: ajuste na GUI e salve de volta o Home.xml (unzip).
-->
<home version="7300" name="${projeto_nome}" camera="topCamera" wallHeight="${edificacao_pe_direito}">
  <property name="com.eteks.sweethome3d.SweetHome3D.origem" value="arch-engine"/>

  <environment groundColor="A8B99A" skyColor="CCE4FC" lightColor="D8D8D8" ceillingLightColor="D0D0D0"
               wallsAlpha="0" photoWidth="1600" photoHeight="1200" photoAspectRatio="RATIO_4_3" photoQuality="2"/>

  <compass x="${compass_x}" y="${compass_y}" diameter="100" northDirection="${lote_orientacao_norte_rad}"/>

  <!-- Vista aérea (topCamera) e observador em frente à fachada. -->
  <camera attribute="topCamera" lens="PINHOLE" x="${camera_top_x}" y="${camera_top_y}" z="${camera_top_z}"
          yaw="${camera_top_yaw}" pitch="0.65" fieldOfView="1.1" time="1782475200000"/>
  <observerCamera attribute="observerCamera" lens="PINHOLE" x="${camera_obs_x}" y="${camera_obs_y}" z="170"
                  yaw="${camera_obs_yaw}" pitch="0.05" fieldOfView="1.1" time="1782475200000"/>

  <!-- A edificação exportada pelo OpenSCAD (OFF → OBJ). Dimensões = bbox da malha. -->
  <pieceOfFurniture name="${projeto_nome} (OpenSCAD)" model="${modelo_obj}"
                    x="${edificacao_x}" y="${edificacao_y}" elevation="0"
                    width="${modelo_largura}" depth="${modelo_profundidade}" height="${modelo_altura}"
                    movable="false" resizable="false" deformable="false"/>

  <!-- Sol de tarde: luz pontual alta, a noroeste da edificação. -->
  <light name="Sol (tarde)" model="luz/luz.obj" power="0.9"
         x="${luz_x}" y="${luz_y}" elevation="${luz_z}" width="1" depth="1" height="1"
         movable="false" visible="false">
    <lightSource x="0.5" y="0.5" z="0.5" color="FFF4DC" diameter="0.5"/>
  </light>

  <!-- Cômodo = projeção da edificação; dá área e piso à planta humanizada. -->
  <room name="${projeto_nome}" areaVisible="true" floorColor="D9C7A7" ceilingVisible="false">
    <point x="${edificacao_x0}" y="${edificacao_y0}"/>
    <point x="${edificacao_x1}" y="${edificacao_y0}"/>
    <point x="${edificacao_x1}" y="${edificacao_y1}"/>
    <point x="${edificacao_x0}" y="${edificacao_y1}"/>
  </room>
</home>
